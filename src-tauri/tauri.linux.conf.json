{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "io.github.spkiddai.luma",
  "bundle": {
    "targets": [
      "deb",
      "rpm"
    ],
    "linux": {
      "deb": {
        "depends": [
          "openssl",
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "openssl",
          "libayatana-appindicator-gtk3"
        ]
      }
    },
    "externalBin": [
      "sidecar/luma-mihomo"
    ]
  }
}
