{
  "name": "luma-proxy",
  "productName": "Luma",
  "version": "0.2.0",
  "private": true,
  "description": "Luma — a lightweight proxy client powered by mihomo",
  "type": "module",
  "main": "electron/main.mjs",
  "license": "GPL-3.0-only",
  "author": "Luma Contributors",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "core:download": "node scripts/download-core.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac zip --arm64 && npm run installer:mac",
    "installer:mac": "node scripts/build-mac-installer.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64",
    "icons:generate": "node scripts/create-icons.mjs",
    "test:packaged": "node scripts/test-packaged.mjs",
    "geodata:download": "node scripts/download-geodata.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.9.1",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "io.github.spkiddai.luma",
    "productName": "Luma",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/icon.png",
      "resources/tray.png",
      "resources/tray@2x.png",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "resources/core/${os}-${arch}",
        "to": "core",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/licenses",
        "to": "licenses"
      },
      {
        "from": "resources/geodata",
        "to": "geodata",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "resources/icon.icns",
      "identity": null,
      "target": [
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "icon": "resources/icon.png"
    },
    "beforePack": "./scripts/check-geodata.cjs",
    "executableName": "Luma"
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  }
}
